# ---------------------------------------------------------------------------
# MoodQueue configuration. EVERYTHING IS OPTIONAL.
# Copy to ".env" (repo root for Docker, or backend/.env for local dev).
# Leave a value empty to use the built-in fallback shown in brackets.
# ---------------------------------------------------------------------------

# Database [SQLite file in DATA_DIR]. Postgres URLs from Railway work as-is.
DATABASE_URL=

# JWT signing key [random key generated once and stored in DATA_DIR]
SECRET_KEY=

# AI mood analysis with Groq (free key at console.groq.com) [offline engine]
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Spotify (developer.spotify.com/dashboard) [built-in catalog + search links]
# The redirect URI must also be added in the Spotify dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/playlist/callback

# Password reset emails via Resend (resend.com) [reset link printed in logs]
RESEND_API_KEY=
EMAIL_FROM=MoodQueue <onboarding@resend.dev>

# Public URL of the web app, only if it's NOT served by this backend
# (e.g. https://mood-queue-one.vercel.app) [same origin]
FRONTEND_URL=
# Extra CORS origins, comma-separated
FRONTEND_ORIGINS=
